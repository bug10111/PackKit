<ui:FluentWindow x:Class="PackKit.Builder.EditPackageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="编辑安装包"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="编辑安装包"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Padding="0,4,0,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ui:TextBox x:Name="NameBox"
                        Grid.Row="0" Grid.Column="1"
                        Height="32"
                        Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="安装包文件：" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBlock x:Name="FileNameText"
                       Grid.Row="1" Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="类型：" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBlock x:Name="InstallerTypeText"
                       Grid.Row="2" Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="分组：" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox x:Name="GroupCombo"
                      Grid.Row="3" Grid.Column="1"
                      Height="32"
                      Margin="0,0,0,8"
                      DisplayMemberPath="DisplayName" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="静默参数：" VerticalAlignment="Top" Margin="0,0,8,0" />
            <ui:TextBox x:Name="SilentArgsBox"
                        Grid.Column="1"
                        Height="32"
                        PlaceholderText="留空表示安装时由用户人工点下一步" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="类型由文件头自动探测，不可手动修改；参数可按安装包官方文档自行调整。"
                   FontSize="{StaticResource CaptionFontSize}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="取消"
                       Appearance="Secondary"
                       IsCancel="True"
                       MinWidth="88"
                       Click="OnCancelClick" />
            <ui:Button Content="确定"
                       Appearance="Primary"
                       IsDefault="True"
                       MinWidth="88"
                       Margin="8,0,0,0"
                       Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
