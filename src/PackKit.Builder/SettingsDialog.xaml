<ui:FluentWindow x:Class="PackKit.Builder.SettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="设置"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Padding="0,4,0,8" />

        <!-- 数据目录区：当前生效目录 + 三项入口 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="数据目录"
                       FontSize="{StaticResource SubtitleFontSize}" />
            <TextBlock Text="设置与本地数据保存在下方目录（默认随应用目录携带，可迁移到其它位置）。"
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,8" />
            <TextBlock x:Name="DataRootText"
                       Text=""
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="打开数据目录"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnOpenDataDirClick" />
                <ui:Button Content="迁移数据目录"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           Click="OnMigrateDataDirClick"
                           Margin="8,0,0,0" />
                <ui:Button Content="打开日志目录"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnOpenLogDirClick"
                           Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,8,0,8" />

        <!-- 云同步备份区：备份目录配置与状态 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="自动备份"
                       FontSize="{StaticResource SubtitleFontSize}" />
            <TextBlock Text="数据目录每日与每次启动时自动备份到百度云同步盘（保留最近 14 份），备份失败不影响使用。"
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="备份目录：" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox Grid.Column="1"
                            x:Name="BackupDirBox"
                            PlaceholderText="留空使用默认目录" />
                <ui:Button Grid.Column="2"
                           Content="浏览"
                           Appearance="Secondary"
                           Click="OnBrowseBackupDirClick"
                           Margin="8,0,0,0" />
            </Grid>
            <TextBlock x:Name="DefaultBackupText"
                       Text=""
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="LastBackupText"
                       Text=""
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ui:Button Grid.Row="4"
                   Content="关闭"
                   Appearance="Secondary"
                   MinWidth="88"
                   HorizontalAlignment="Right"
                   IsCancel="True"
                   Click="OnCloseClick"
                   Margin="0,16,0,0" />
    </Grid>
</ui:FluentWindow>
