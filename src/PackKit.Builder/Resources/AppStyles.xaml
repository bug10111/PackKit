<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 字号档位：取自 WPF-UI 4.0.2 Typography 阶梯（Caption=12 / Body=14 / Subtitle=20），全局统一取档 -->
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">20</sys:Double>

    <!-- 布尔到可见性转换器（全局复用） -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- 按钮高度全局统一档位：全部按钮经本样式统一定高，页面内禁止散写 Height -->
    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 下拉按钮与按钮同档对齐：工具条分组下拉与相邻按钮高度一致 -->
    <Style TargetType="ui:DropDownButton" BasedOn="{StaticResource {x:Type ui:DropDownButton}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 表单控件与按钮同行高度对齐：文本输入框与按钮同高，保证同一表单行内对齐 -->
    <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 下拉框与按钮/输入框同档对齐：表单行内控件高度一致 -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- 下拉项高度与内边距：修复下拉项过矮致 14px 正文字体显示不全（MinHeight 对齐控件 32 档，上下内边距按 4 档基准取 6 保证字形完整） -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

</ResourceDictionary>
