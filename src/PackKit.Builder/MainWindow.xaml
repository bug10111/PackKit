<ui:FluentWindow x:Class="PackKit.Builder.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="装机包制作工具"
                 Icon="pack://application:,,,/PackKit.Builder;component/Assets/sp.ico"
                 Width="1080"
                 Height="720"
                 MinWidth="920"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Closing="OnWindowClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题条：窗口标题 + 开源地址链接 + 系统三键（工程随数据目录自动保存，无手动工程按钮）；Icon 经 ImageIcon 显式落标题栏（TitleBar.Icon 为 IconElement 类型，字符串赋值不渲染） -->
        <ui:TitleBar Grid.Row="0"
                     Title="装机包制作工具"
                     Padding="8,4">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PackKit.Builder;component/Assets/sp.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <!-- 开源地址：项目主页导航（点击经系统默认浏览器打开） -->
                    <ui:Button Content="GitHub ↗"
                               Appearance="Transparent"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Click="OnGitHubClick"
                               ToolTip="开源地址：github.com/bug10111/PackKit"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 安装包工具条：添加入口、分组范围下拉与拖拽提示 -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="＋添加安装包"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Add24}"
                           Click="OnAddFilesClick" />
                <ui:Button Content="＋添加整个文件夹"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           Click="OnAddFolderClick"
                           Margin="8,0,0,0" />
                <!-- 分组下拉：按钮文案即当前分组范围（「全部」或某分组），点开即分组管理面板（Button+Popup 标准原语，主题库 DropDownButton 实测点击不弹层） -->
                <ui:Button x:Name="GroupMenuButton"
                           Content="{Binding SelectedGroupDisplayText, Mode=OneWay}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Group24}"
                           Margin="8,0,0,0"
                           Click="OnGroupMenuButtonClick" />
                <Popup x:Name="GroupMenuPopup"
                       PlacementTarget="{Binding ElementName=GroupMenuButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Closed="OnGroupMenuPopupClosed">
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,4,8,8">
                        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="272">
                                    <!-- 全部：置顶筛选项，对勾图标冗余标注当前范围 -->
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Click="OnGroupFilterAllClick"
                                               ToolTip="显示全部安装包">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="Checkmark24"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsAllGroupsFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Grid.Column="1" Text="全部" />
                                        </Grid>
                                    </ui:Button>
                                    <!-- 分组行：名称即筛选入口，行内 ✎ 改名（沿用重名校验）、× 删除（沿用确认与回落） -->
                                    <ItemsControl x:Name="GroupMenuList"
                                                  ItemsSource="{Binding GroupMenuItems, Mode=OneWay}"
                                                  Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid x:Name="GroupRowView">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0"
                                                                       Symbol="Checkmark24"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <ui:Button Grid.Column="1"
                                                                   Content="{Binding Name, Mode=OneWay}"
                                                                   HorizontalAlignment="Stretch"
                                                                   HorizontalContentAlignment="Left"
                                                                   Click="OnGroupFilterItemClick"
                                                                   ToolTip="只显示该分组的安装包" />
                                                        <ui:Button Grid.Column="2"
                                                                   Icon="{ui:SymbolIcon Edit24}"
                                                                   Appearance="Transparent"
                                                                   Click="OnGroupMenuRenameClick"
                                                                   ToolTip="重命名分组"
                                                                   Margin="4,0,0,0" />
                                                        <ui:Button Grid.Column="3"
                                                                   Icon="{ui:SymbolIcon Dismiss24}"
                                                                   Appearance="Danger"
                                                                   Click="OnGroupMenuDeleteClick"
                                                                   ToolTip="删除分组"
                                                                   Margin="4,0,0,0" />
                                                    </Grid>
                                                    <StackPanel x:Name="GroupRowEdit"
                                                                Orientation="Horizontal"
                                                                Visibility="Collapsed">
                                                        <ui:TextBox Width="160"
                                                                    MaxLength="50"
                                                                    Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    KeyDown="OnGroupRenameBoxKeyDown"
                                                                    IsVisibleChanged="OnGroupRenameBoxIsVisibleChanged" />
                                                        <ui:Button Icon="{ui:SymbolIcon Checkmark24}"
                                                                   Click="OnGroupMenuRenameConfirmClick"
                                                                   ToolTip="确认重命名"
                                                                   Margin="4,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                                                        <Setter TargetName="GroupRowView" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="GroupRowEdit" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator Margin="0,8,0,4" />
                                    <!-- 新建分组：常驻输入框 + 「添加」按钮（Enter 同效），成功后自动选中为新筛选范围 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:TextBox x:Name="CreateGroupNameBox"
                                                    Width="160"
                                                    MaxLength="50"
                                                    PlaceholderText="输入新分组名"
                                                    KeyDown="OnGroupCreateBoxKeyDown" />
                                        <ui:Button Content="添加"
                                                   Icon="{ui:SymbolIcon Add24}"
                                                   Appearance="Secondary"
                                                   Click="OnGroupCreateConfirmClick"
                                                   ToolTip="创建分组并选中为筛选范围"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <ui:Button Content="设置"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Settings24}"
                           Click="OnSettingsClick"
                           Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="支持把安装包文件直接拖进下方列表"
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- 安装包列表：分组范围由工具条分组下拉控制，空态占位与拖拽落点 -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <DataGrid x:Name="PackagesGrid"
                      ItemsSource="{Binding ItemsView, Mode=OneWay}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      RowHeight="40"
                      AllowDrop="True"
                      Drop="OnPackagesDrop"
                      PreviewDragOver="OnPackagesDragOver">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="48">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4,0,4,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="分组" Binding="{Binding GroupDisplay, Mode=OneWay}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4,0,4,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="安装包文件" Binding="{Binding FileName, Mode=OneWay}" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4,0,4,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="静默参数" Binding="{Binding SilentArgs, Mode=OneWay}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4,0,4,0" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="类型" Binding="{Binding InstallerTypeDisplay, Mode=OneWay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="4,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, Mode=OneWay}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="暂无数据"
                           FontSize="{StaticResource SubtitleFontSize}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击上方按钮添加安装包，或把 exe / msi 文件直接拖进列表"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- 选中项操作条与合计 -->
        <Grid Grid.Row="3" Margin="16,8,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="选中项："
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ui:Button Content="编辑参数"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Edit24}"
                           Click="OnEditSelectedClick" />
                <ui:Button Content="上移"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowUp24}"
                           Command="{Binding MoveUpCommand}"
                           Margin="8,0,0,0" />
                <ui:Button Content="下移"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowDown24}"
                           Command="{Binding MoveDownCommand}"
                           Margin="8,0,0,0" />
                <ui:Button Content="删除"
                           Appearance="Danger"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding DeleteSelectedCommand}"
                           Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Separator Grid.Row="4" Margin="16,0,16,0" />

        <!-- 成品设置 -->
        <StackPanel Grid.Row="5" Margin="16,12,16,0">
            <TextBlock Text="成品设置"
                       FontSize="{StaticResource SubtitleFontSize}" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="标题：" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ui:TextBox Grid.Row="0" Grid.Column="1"
                            Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="必填，如：2026常用装机包"
                            MinWidth="240"
                            Margin="0,0,8,8" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="图标：" VerticalAlignment="Center" Margin="8,0,8,8" />
                <ui:TextBox Grid.Row="0" Grid.Column="4"
                            Text="{Binding IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="可选 .ico（当前版本暂不嵌入，见打包提示）"
                            MinWidth="200"
                            Margin="0,0,8,8" />
                <ui:Button Grid.Row="0" Grid.Column="6"
                           Content="浏览"
                           Appearance="Secondary"
                           Click="OnBrowseIconClick"
                           Margin="0,0,8,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="壳模板：" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ui:TextBox Grid.Row="1" Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Text="{Binding ShellExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="成品端壳程序（默认已按随包约定定位）"
                            Margin="0,0,8,8" />
                <ui:Button Grid.Row="1" Grid.Column="6"
                           Content="浏览"
                           Appearance="Secondary"
                           Click="OnBrowseShellClick"
                           Margin="0,0,8,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="输出：" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox Grid.Row="2" Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Text="{Binding OutputExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="成品 exe 输出路径"
                            Margin="0,0,8,0" />
                <ui:Button Grid.Row="2" Grid.Column="6"
                           Content="浏览"
                           Appearance="Secondary"
                           Click="OnBrowseOutputClick" />
            </Grid>

            <!-- 唯一主操作：打包生成成品 -->
            <ui:Button Appearance="Primary"
                       Content="打包生成成品 EXE"
                       Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding PackCommand}"
                       MinWidth="260"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,4" />
        </StackPanel>

        <!-- 反馈条（错误/成功/提示） -->
        <ui:InfoBar Grid.Row="6"
                    IsOpen="{Binding IsFeedbackOpen, Mode=TwoWay}"
                    Severity="{Binding FeedbackSeverity}"
                    Title="{Binding FeedbackTitle}"
                    Message="{Binding FeedbackMessage}"
                    IsClosable="True"
                    Margin="16,4,16,0" />

        <!-- 打包进度条 -->
        <Grid Grid.Row="7" Margin="16,8,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Height="6"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProgressPercentText, Mode=OneWay}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       MinWidth="40"
                       TextAlignment="Right" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ProgressStatus, Mode=OneWay}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Grid.Column="3"
                       Content="打开所在文件夹"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenOutputFolderCommand}"
                       Visibility="{Binding IsSuccessFeedback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="16,0,0,0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
