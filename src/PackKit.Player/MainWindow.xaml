<ui:FluentWindow x:Class="PackKit.Player.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="装机包"
                 Icon="pack://application:,,,/PackKit.Player;component/Assets/sp.ico"
                 Width="800"
                 Height="560"
                 MinWidth="640"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏分组筛选：仅清单携带分组数据时显示（无分组数据整体隐藏，与旧成品界面一致）；当前项高亮由列表选中态呈现 -->
        <Border x:Name="GroupPanel"
                Grid.Column="0"
                Width="168"
                Margin="16,12,0,16"
                Padding="4"
                CornerRadius="4"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="GroupList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionMode="Single"
                         SelectionChanged="GroupList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,8"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Display, Mode=OneWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- 标题栏：窗口标题取清单 Title；提权徽标经 TrailingContent 落在窗口控制三键左侧；Icon 经 ImageIcon 显式落标题栏（TitleBar.Icon 为 IconElement 类型，字符串赋值不渲染） -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="TitleBar"
                     Title="装机包">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PackKit.Player;component/Assets/sp.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <!-- 开源地址：项目主页导航（点击经系统默认浏览器打开） -->
                    <ui:Button Content="GitHub ↗"
                               Appearance="Transparent"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Click="OnGitHubClick"
                               ToolTip="开源地址：github.com/bug10111/PackKit"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ElevationBadge"
                               Margin="0,0,8,0"
                               FontSize="12"
                               VerticalAlignment="Center">
                        <Run x:Name="ElevationDot" Text="● " />
                        <Run x:Name="ElevationText" Text="检测中" />
                    </TextBlock>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 工具栏：全选（三态联动） + 搜索（按名称实时过滤，只影响显示不影响勾选） -->
        <Grid Grid.Row="1"
              x:Name="ToolbarPanel"
              Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      x:Name="SelectAllCheckBox"
                      Content="全选"
                      IsThreeState="True"
                      VerticalContentAlignment="Center"
                      Click="SelectAll_Click" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="搜索:" />
            <ui:TextBox Grid.Column="3"
                        x:Name="SearchBox"
                        Width="220"
                        MaxLength="100"
                        PlaceholderText="按名称过滤"
                        TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- 清单列表：勾选框 + 图标（无图标显示统一占位字形） + 名称 + 大小（右对齐） + 状态标签 + 失败行重试按钮 -->
        <Border Grid.Row="2"
                x:Name="ListPanel"
                Margin="16,0,16,0"
                Padding="0"
                CornerRadius="4"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSelectable, Mode=OneWay}" />
                                <Grid Grid.Column="1"
                                      Width="20"
                                      Height="20"
                                      Margin="8,0,8,0"
                                      VerticalAlignment="Center">
                                    <Image Source="{Binding Icon, Mode=OneWay}"
                                           Width="20"
                                           Height="20"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon, Mode=OneWay}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- 无图标占位：主题库自带 Box24 字形配灰调，禁止文字裸占位 -->
                                    <Border VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon, Mode=OneWay}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Symbol="Box24"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,8,0"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DisplayName, Mode=OneWay}" />
                                <TextBlock Grid.Column="3"
                                           Margin="0,0,12,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SizeText, Mode=OneWay}" />
                                <Border Grid.Column="4"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{Binding StatusBackground, Mode=OneWay}"
                                        ToolTip="{Binding StatusDetail, Mode=OneWay}">
                                    <TextBlock FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding StatusText, Mode=OneWay}"
                                               Foreground="{Binding StatusForeground, Mode=OneWay}" />
                                </Border>
                                <ui:Button Grid.Column="5"
                                           Margin="8,0,0,0"
                                           Padding="8,0"
                                           Appearance="Secondary"
                                           Content="重试"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Click="RetryButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 空状态占位（裸壳 / 清单损坏 / 清单为空时替代列表区，居中属空态豁免） -->
        <StackPanel Grid.Row="2"
                    x:Name="EmptyStatePanel"
                    Visibility="Collapsed"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Warning24"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Foreground="#BC4C00" />
            <TextBlock x:Name="EmptyStateTitle"
                       Margin="0,12,0,0"
                       FontSize="20"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="本程序为未打包的壳模板，请用装机包制作工具打包后使用" />
            <TextBlock x:Name="EmptyStateDetail"
                       Margin="0,8,0,0"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 唯一主 CTA：安装勾选项（N） -->
        <ui:Button Grid.Row="3"
                   x:Name="InstallButton"
                   Margin="0,16,0,16"
                   MinWidth="220"
                   HorizontalAlignment="Center"
                   Appearance="Primary"
                   Content="安装勾选项（0）"
                   IsEnabled="False"
                   Click="InstallButton_Click">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Play24" />
            </ui:Button.Icon>
        </ui:Button>

        <Separator Grid.Row="4"
                   Margin="16,0,16,0" />

        <!-- 底部状态行：安装中逐项流转，结束时给汇总 -->
        <TextBlock Grid.Row="5"
                   x:Name="StatusLine"
                   Margin="16,12,16,16"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Text="就绪" />
        </Grid>
    </Grid>
</ui:FluentWindow>
