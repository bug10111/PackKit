<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>PackKit.Player</RootNamespace>
    <AssemblyName>PackKit.Player</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\sp.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 离线构建环境（远程 NuGet 源不可达，包经本地缓存供给）：关闭还原期漏洞审计联网拉取，避免 NU1900 阻塞还原 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\sp.ico">
      <Link>Assets\sp.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PackKit.Core\PackKit.Core.csproj" />
  </ItemGroup>

</Project>
